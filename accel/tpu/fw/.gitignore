# Build output. The .hex is generated too — unlike tb/fw_smoke.hex, which is
# hand-encoded precisely so the CPU testbench needs no toolchain.
*.o
*.d
*.elf
*.hex
*.map

# The requant table infer_export.py derives from a real checkpoint and builds
# infer.c against. Generated per run; the tracked table is infer_rq.h, whose
# words are tuned for the synthetic test operands instead.
adder_rq_ckpt.h
infer_rq_ckpt.h
